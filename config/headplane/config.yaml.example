server:
  host: "0.0.0.0"
  port: 3000
  base_url: "https://admin.example.com"
  cookie_secret: "CHANGE_ME_EXACTLY_32_CHARS_LONG!"
  cookie_secure: true
  cookie_max_age: 86400
  data_path: "/var/lib/headplane"

headscale:
  url: "http://headscale:8080"
  public_url: "https://vpn.example.com"
  config_path: "/etc/headscale/config.yaml"
  # Gere com: docker compose exec headscale headscale apikeys create
  api_key: "CHANGE_ME"

integration:
  agent:
    enabled: false
  docker:
    enabled: false
  kubernetes:
    enabled: false
  proc:
    enabled: false
